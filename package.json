{
  "name": "tr-naja-gestion",
  "version": "1.0.0",
  "description": "TR Naja - Logiciel de gestion pour demi-grossiste",
  "main": "main.js",
  "author": "TR Naja",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win32": "electron-builder --win --ia32 --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:all": "electron-builder --win --x64 --ia32 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.trnaja.gestion",
    "productName": "TR Naja - Gestion",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*", "build/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TR Naja - Gestion"
    },
    "mac": {
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": { "title": "TR Naja - Gestion", "window": { "width": 540, "height": 380 } }
  }
}
